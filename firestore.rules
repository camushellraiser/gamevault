rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Replace YOUR_FIREBASE_AUTH_UID with the UID displayed by GameVault
    // after the first Google sign-in, THEN publish in Firebase Console.
    function ownerOnly(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.uid == 'YOUR_FIREBASE_AUTH_UID';
    }

    match /users/{uid}/games/{gameId} {
      allow read: if ownerOnly(uid);
      allow create, update: if ownerOnly(uid)
        && request.resource.data.id == gameId
        && request.resource.data.platform in ['ps5', 'ps4', 'switch', 'switch2', 'pc'];
      // Deletions are recoverable edits using deletedAt; hard delete is disabled.
      allow delete: if false;
    }

    // No other collections are accessible from client SDKs.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
